import pandas as pd
import numpy as np

def executar_pipeline():
    print("Iniciando pipeline de tratamento de dados...")
    
    # 1. Extração (Leitura da base bruta do ISP-RJ)
    # Substitua pelo nome exato do seu arquivo bruto em data/raw/
    caminho_entrada = '../data/raw/BaseDossie.xlsx'
    
    try:
        df = pd.read_excel(caminho_entrada)
        print(f"Base carregada com sucesso. Dimensões originais: {df.shape}")
    except FileNotFoundError:
        print(f"Arquivo não encontrado em {caminho_entrada}. Verifique o caminho.")
        return

    # 2. Transformação (Limpeza e tratamento de nulos/tipos)
    # Exemplo de normalização de colunas e tratamento de valores ausentes
    df.columns = [str(col).lower().strip() for col in df.columns]
    
    # Tratamento básico de nulos em colunas numéricas de ocorrências se houverem
    if 'ano' in df.columns:
        df['ano'] = pd.to_numeric(df['ano'], errors='coerce')

    # 3. Carga (Persistência no formato otimizado e interoperável Parquet)
    caminho_saida = '../data/processed/dados_limpos.parquet'
    df.to_parquet(caminho_saida, index=False)
    print(f"Dados processados salvos com sucesso em: {caminho_saida}")

if __name__ == "__main__":
    executar_pipeline()
